{
  "layer": "top",
  "position": "bottom",
  "height": 26,
  "name": "bottom-bar",
  "modules-left": ["custom/niri-workspace-windows"],
  "modules-center": [],
  "modules-right": [],
  "reload_style_on_change": true,
  "custom/niri-workspace-windows": {
    "exec": "sh ~/.config/waybar/scripts/niri-workspace-windows.sh",
    "interval": "once",
    "signal": 9,
  },
}
